# Project URL only. Leave off /rest/v1. The app strips that path if it is present.
SUPABASE_URL=https://your-project.supabase.co
# Supabase service role key. Server only. Never expose this in the browser.
SUPABASE_SECRET_KEY=
# Required on Vercel. A long random string. Sign-in cookies break if this is missing or changes.
SESSION_SECRET=
