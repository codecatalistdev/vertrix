# Project URL only. Leave off /rest/v1. The app strips that path if it is present.
SUPABASE_URL=https://your-project.supabase.co
# Supabase service role key. Server only. Never expose this in the browser.
SUPABASE_SECRET_KEY=
# Required in every environment, including Vercel. At least 32 random characters.
# The session cookie is signed with this value. The app does not read or write it to disk.
# Use the same value on every instance. Changing it signs everyone out.
SESSION_SECRET=
